{
  "description": "SkillTotal's visible check: before a skill runs, before a skill install, and at session start.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skilltotal-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skilltotal-hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
